{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true, 
    "noImplicitAny": true,
    "strict": true 
  },
  "include": ["src/**/*"]
}